# Стек совместимости шаблона nx_template — утверждён 01.10.2026
# Данные: StatCounter (сент. 2026), Яндекс Радар (авг. 2026), caniuse-lite 1.0.30001814
# Яндекс Браузер, Brave, 360, QQ и др. считаются по версии Chromium.
# Пороги выровнены по Битриксу: уровень 1 = main.baseline (плашка «устаревший браузер»),
# уровень 2 = минимум, на котором запускается ядро main.core (ES2022, приватные методы классов).

# --- Уровень 1: полная поддержка (вид и функции как задумано) ---
# Chrome 109 — последний для Windows 7/8.1; Opera 95 — последняя для Windows 7;
# Firefox 115 — ESR для Windows 7/8.1 (Tor/Mullvad — свежий ESR);
# Safari/iOS 16 — как в main.baseline Битрикса (iOS 15.x ушёл на уровень 2, ~0,08% РФ).
chrome >= 109
edge >= 109
opera >= 95
firefox >= 115
safari >= 16
ios_saf >= 16
samsung >= 20
and_chr >= 109
and_ff >= 115

# --- Уровень 2: работоспособность (контент, меню, формы и компоненты Битрикса работают; вид может быть проще) ---
# Нижняя граница = ядро Битрикса: Chrome 84, Firefox 90, Safari 15.
# Android 7+ и встроенные браузеры приложений, старые ядра UC/QQ/360, iOS 15.x.
chrome >= 84
edge >= 84
opera >= 70
firefox >= 90
safari >= 15
ios_saf >= 15
samsung >= 14
and_chr >= 84
and_ff >= 90
and_uc >= 15
op_mob >= 64

# --- Уровень 3: без гарантий (текст читается, ссылки работают) ---
# Всё ниже уровня 2: Chrome 80–83, Firefox 78–89, Safari/iOS 12–14 (~0,03% РФ),
# IE 11, Edge IE mode, Chrome 49 / Firefox 52 на Windows XP — в список не включаются.
